<Window x:Class="ManuskriptHelfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manuskript-Helfer" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenButton" Content="Manuskript öffnen …" Padding="14,6"
                    Click="OpenButton_Click" />
            <Button x:Name="ExportButton" Content="Review exportieren …" Padding="14,6"
                    Margin="8,0,0,0" IsEnabled="False"
                    Click="ExportButton_Click" />
            <Button Content="Geprüfte verwalten …" Padding="14,6" Margin="8,0,0,0"
                    Click="ManageReviewed_Click" />
            <TextBlock x:Name="FileLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="Noch keine Datei geladen" />
        </StackPanel>

        <TextBlock x:Name="SummaryLabel" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <TabControl>
            <TabItem Header="Statistik">
                <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kapitel" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Wörter" Binding="{Binding Words}" />
                        <DataGridTextColumn Header="Zeichen" Binding="{Binding Characters}" />
                        <DataGridTextColumn Header="Sätze" Binding="{Binding Sentences}" />
                        <DataGridTextColumn Header="Ø Satzlänge"
                                            Binding="{Binding AvgSentenceLength, StringFormat=N1}" />
                        <DataGridTextColumn Header="Lesezeit (Min.)"
                                            Binding="{Binding ReadingMinutes, StringFormat=N1}" />
                        <DataGridTextColumn Header="Normseiten"
                                            Binding="{Binding NormPages, StringFormat=N1}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Wiederholungen">
                <DataGrid x:Name="RepetitionGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Extended">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown"
                                         Handler="GridRow_PreviewMouseRightButtonDown" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Als geprüft markieren (ausblenden)"
                                      Click="MarkRepetitionsReviewed_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kapitel" Binding="{Binding Chapter}" Width="150" />
                        <DataGridTextColumn Header="Wort" Binding="{Binding Word}" Width="120" />
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Occurrences}" />
                        <DataGridTextColumn Header="Stelle" Binding="{Binding Context}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Häufige Wörter">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Nur Hinweise: häufigste Wörter pro Kapitel (Stoppwörter und Figuren-/Ortsnamen ausgeblendet). Die konkreten Stellen findest du über die Suche in Word oder über den Tab 'Wiederholungen'." />
                    <DataGrid x:Name="FrequencyGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kapitel" Binding="{Binding Chapter}" Width="*" />
                            <DataGridTextColumn Header="Wort" Binding="{Binding Word}" Width="180" />
                            <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Figuren">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Figurenliste bearbeiten …" Padding="12,5"
                                Click="EditCharacters_Click" />
                        <Button Content="Neu auswerten" Padding="12,5" Margin="8,0,0,0"
                                Click="Recheck_Click" />
                        <TextBlock x:Name="CharacterInfo" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Auftritte pro Kapitel">
                            <DataGrid x:Name="MatrixGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False"
                                      AutoGeneratingColumn="MatrixGrid_AutoGeneratingColumn" />
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

                        <GroupBox Grid.Row="2" Header="Mögliche Schreibvarianten (Tippfehler?)">
                            <DataGrid x:Name="VariantGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Extended">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="PreviewMouseRightButtonDown"
                                                     Handler="GridRow_PreviewMouseRightButtonDown" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Als geprüft markieren (ausblenden)"
                                                  Click="MarkVariantsReviewed_Click" />
                                        <MenuItem Header="Als Alias übernehmen (figuren.json ergänzen)"
                                                  Click="AddVariantAsAlias_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kapitel" Binding="{Binding Chapter}" Width="140" />
                                    <DataGridTextColumn Header="Gefunden" Binding="{Binding Found}" Width="120" />
                                    <DataGridTextColumn Header="Ähnlich zu" Binding="{Binding SimilarTo}" Width="120" />
                                    <DataGridTextColumn Header="Anzahl" Binding="{Binding Occurrences}" Width="70" />
                                    <DataGridTextColumn Header="Stelle" Binding="{Binding Context}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>